{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "node": "24.15.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://test.api.marktcommerce.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "node": "24.15.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://test.api.marktcommerce.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "node": "24.15.0",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.marktcommerce.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "appleId": "marktcommerce2020@gmail.com",
        "appleTeamId": "AU56ZMM56Y"
      }
    }
  }
}
